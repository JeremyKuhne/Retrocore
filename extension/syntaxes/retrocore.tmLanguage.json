          "begin": "\\G[ \\t]*((?i:\\.(?:equ|set|byte|word|dword|res|org|logicalorg|align|dum|dend|checksum|assert|export|hiascii|section|include|incbin|macro|endmacro|local|exitmacro|if|elseif|else|endif|ifdef|ifndef|ifblank|repeat|endrepeat|proc|endproc|scope|endscope|setcpu|p02|pc02|psc02|segment|code|rodata|data|bss|zeropage|addr|endmac|endrep|define|undefine|struct|endstruct|union|endunion|enum|endenum|tag|charmap|asciiz|byt|dbyt|faraddr|lobytes|hibytes|ifconst|ifnconst|ifnblank|ifp02|ifp02x|ifpsc02|ifpc02|ifpwc02|ifpce02|ifp816|ifp4510|ifp45gs02|ifp6280|ifpdtv|ifpm740|ifpsweet16|ifref|ifnref|feature|debuginfo|list|smart|out|warning|error|fatal|global|globalzp|import|importzp|exportzp|macpack|reloc|mac)))(?=[\\s;]|$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.retrocore"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#anonymous-labels"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#symbols"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "(;;)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.retrocore"
            }
          },
          "end": "$",
          "name": "comment.line.documentation.retrocore",
          "patterns": [
            {
              "match": "\\G[ \\t]*((?i:In|Out|Flags|Errors|Uses|Keeps|Entry|Calls|Cycles|Stack|Model|Parameters|Members|Example|See(?: also)?|Deprecated|Inherit|Include)):",
              "captures": {
                "1": {
                  "name": "keyword.other.documentation.retrocore"
                }
              }
            },
            {
              "match": "<(?![\\s=\\d])[^<>]+>",
              "name": "markup.underline.link.retrocore"
            },
            {
              "match": "\\{[\\w@.:]+\\}",
              "name": "variable.parameter.documentation.retrocore"
            },
            {
              "match": "`[^`]*`",
              "name": "markup.inline.raw.retrocore"
            }
          ]
        },
        {
          "match": "(;).*$",
          "name": "comment.line.semicolon.retrocore",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.retrocore"
            }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "begin": "'",
          "end": "'|(?=$)",
          "name": "string.quoted.single.retrocore",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.retrocore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.retrocore"
            }
          }
        },
        {
          "begin": "\"",
          "end": "\"|(?=$)",
          "name": "string.quoted.double.retrocore",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.retrocore"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.retrocore"
            }
          }
        },
        {
          "match": "(?<![\\w$])(?:\\$[0-9A-Fa-f]+|0[xX][0-9A-Fa-f]+)\\b",
          "name": "constant.numeric.hex.retrocore"
        },
        {
          "match": "(?<!\\w)%[01]+\\b",
          "name": "constant.numeric.binary.retrocore"
        },
        {
          "match": "(?<!\\w)[0-9]+\\b",
          "name": "constant.numeric.decimal.retrocore"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "#",
          "name": "keyword.operator.immediate.retrocore"
        },
        {
          "match": "(?<![\\w$.])(?:[aAzZ]:(?!:)|!(?!=))",
          "name": "keyword.operator.width.retrocore"
        },
        {
          "match": "(?i:\\.(?:not|and|or|xor|mod|lobyte|hibyte|bankbyte|paramcount|sizeof|time|version|defined|def|definedmacro|strlen|strat|ident|concat|string|sprintf|min|max|loword|hiword|match|xmatch|tcount|blank|left|right|mid|const|cpu))\\b",
          "name": "keyword.operator.retrocore"
        },
        {
          "match": "==|!=|<=|>=|<<|>>|&&|\\|\\||[=+*/&|^~<>-]",
          "name": "keyword.operator.retrocore"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.retrocore"
        },
        {
          "match": ",",
          "name": "punctuation.separator.operand.retrocore"
        }
      ]
    },
    "registers": {
      "match": "(?<=,)[ \\t]*([XxYy])(?=[ \\t]*(?:\\)|;|$))",
      "captures": {
        "1": {
          "name": "variable.language.register.retrocore"
        }
      }
    },
    "anonymous-labels": {
      "match": ":(?:\\++|-+)",
      "name": "variable.other.symbol.retrocore"
    },
    "symbols": {
      "match": "(?:(?:::)?[A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]*(?:::[A-Za-z_][\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]*)*|@[\\p{L}\\p{Mn}\\p{Nd}\\p{Pc}]+)",
      "name": "variable.other.symbol.retrocore"
    }
  }
}
