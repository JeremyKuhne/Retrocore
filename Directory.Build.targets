<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Native AOT compiles with the SDK's bundled ILCompiler pack, which can trail a security fix (10.0.13 has
       GHSA-p3jp-9v83-76w9). The SDK warns on an explicit ILCompiler reference, so raise the pack it picks. -->
  <PropertyGroup>
    <RetrocoreILCompilerVersion>10.0.15</RetrocoreILCompilerVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <KnownILCompilerPack Update="@(KnownILCompilerPack)" ILCompilerPackVersion="$(RetrocoreILCompilerVersion)" />
  </ItemGroup>

  <!-- Touki's runtime package can bring a published analyzer transitively; use only the local build. -->
  <Target Name="_RemovePackagedToukiAnalyzers"
          AfterTargets="ResolveLockFileAnalyzers"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_PackagedToukiAnalyzer Include="@(Analyzer)"
                             Condition="'%(Analyzer.NuGetPackageId)' == 'KlutzyNinja.Touki.Analyzers'" />
      <Analyzer Remove="@(_PackagedToukiAnalyzer)" />
    </ItemGroup>
  </Target>
</Project>
