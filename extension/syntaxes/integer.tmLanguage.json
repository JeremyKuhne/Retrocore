          "name": "entity.name.label.retrocore-integer"
        },
        {
          "match": "(?i:(HIMEM:)|(LOMEM:)|(LOAD)|(SAVE)|(CON)|(RUN)|(DEL)|(NEW)|(CLR)|(AUTO)|(MAN)|(\\+)|(-)|(\\*)|(/)|(=)|(#)|(>=)|(>)|(<=)|(<>)|(<)|(AND)|(OR)|(MOD)|(\\^)|(NOT)|(THEN)|(PEEK)|(RND)|(SGN)|(ABS)|(PDL)|(RNDX)|(LEN)|(ASC)|(SCRN)|(TEXT)|(GR)|(CALL)|(DIM)|(TAB)|(END)|(INPUT)|(FOR)|(TO)|(STEP)|(NEXT)|(RETURN)|(GOSUB)|(LET)|(G\\s*O\\s*T\\s*O)|(IF)|(PRINT)|(POKE)|(COLOR=)|(PLOT)|(HLIN)|(AT(?![NnOo]))|(VLIN)|(VTAB)|(LIST)|(POP)|(NODSP)|(NOTRACE)|(DSP)|(TRACE)|(PR#)|(IN#))",
          "captures": {
