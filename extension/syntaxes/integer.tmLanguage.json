{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Integer BASIC",
  "scopeName": "source.retrocore-integer",
  "patterns": [
    {
      "include": "#pragma"
    },
    {
      "match": "^\\s*(?:@[A-Za-z_][A-Za-z0-9_]*|[A-Za-z_][A-Za-z0-9_]*:)\\s*$",
      "name": "entity.name.label.retrocore-integer"
    },
    {
      "match": "^\\s*(\\d+)",
      "captures": {
        "1": {
          "name": "entity.name.label.line-number.retrocore-integer"
        }
      }
    },
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "pragma": {
      "match": "^\\s*(?:REM|')\\s*retrocore\\s+\\S+.*$",
      "name": "comment.line.pragma.retrocore-integer"
    },
    "statements": {
