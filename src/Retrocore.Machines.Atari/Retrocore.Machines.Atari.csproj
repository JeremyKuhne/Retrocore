<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atari 400 and 800: ANTIC, GTIA, POKEY, the PIA, the keyboard and the cartridge slots. The 810 shares the
       TRS-80's FD1771, as the Color Computer shares it for its WD1793. -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KlutzyNinja.Touki" Version="0.10.0" />
    <InternalsVisibleTo Include="Retrocore.Tests" />
    <InternalsVisibleTo Include="Retrocore.Perf" />
    <AdditionalFiles Include="..\Retrocore.Cpu.M6502\OpcodeTables.txt" />
    <AdditionalFiles Include="Roms\*.rom.asm" />
    <ProjectReference Include="..\Retrocore.Core\Retrocore.Core.csproj" />
    <ProjectReference Include="..\Retrocore.Cpu.M6502\Retrocore.Cpu.M6502.csproj" />
    <ProjectReference Include="..\Retrocore.Media\Retrocore.Media.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Chips\Retrocore.Machines.Chips.csproj" />
    <ProjectReference Include="..\Retrocore.Generators\Retrocore.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
