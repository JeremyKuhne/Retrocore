<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks />
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- The host is also the .NET tool retrocore (dotnet pack), whose command is `retrocore build` and the rest. Its
         Sdk/ and Schemas/ folders go in the package as they go beside the host. It is not published anywhere yet, so
         it installs from the folder dotnet pack wrote, as CI's tool step does. A native (RetrocoreAot) build is not a
         tool. -->
    <IsPackable>false</IsPackable>
    <IsPackable Condition="'$(RetrocoreAot)' != 'true'">true</IsPackable>
    <PackAsTool Condition="'$(RetrocoreAot)' != 'true'">true</PackAsTool>
    <ToolCommandName>retrocore</ToolCommandName>
    <PackageId>retrocore</PackageId>
    <PackageVersion>0.1.0-dev</PackageVersion>
    <Authors>Jeremy W Kuhne</Authors>
    <Description>Retrocore's debug host and command line: retrocore build builds a project's retrocore.json targets for retro machines, with the SDK's ROM sources.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The host stays free of reflection so it can be compiled ahead of time; the analyzers report what would
         stop it. dotnet publish -p:RetrocoreAot=true builds it native. (PublishAot itself would also reach the
         analyzer and generator projects it references, which cannot be.) -->
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(RetrocoreAot)' == 'true'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Retrocore.Cpu" />
    <Using Include="Retrocore.Cpu.M6502" />
    <ProjectReference Include="..\Retrocore.Assembler\Retrocore.Assembler.csproj" />
    <ProjectReference Include="..\Retrocore.Basic\Retrocore.Basic.csproj" />
    <ProjectReference Include="..\Retrocore.Media\Retrocore.Media.csproj" />
    <ProjectReference Include="..\Retrocore.Pascal\Retrocore.Pascal.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Apple1\Retrocore.Machines.Apple1.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Apple2\Retrocore.Machines.Apple2.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Apple3\Retrocore.Machines.Apple3.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Atari\Retrocore.Machines.Atari.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Coco\Retrocore.Machines.Coco.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Acorn\Retrocore.Machines.Acorn.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Commodore\Retrocore.Machines.Commodore.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Altair\Retrocore.Machines.Altair.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Trs80\Retrocore.Machines.Trs80.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Kaypro\Retrocore.Machines.Kaypro.csproj" />
    <ProjectReference Include="..\Retrocore.Input\Retrocore.Input.csproj" />
    <!-- Retrocore Desktop's spike runs the machines through the debug host's targets (docs/backlog/Desktop.md). -->
    <InternalsVisibleTo Include="retrocore-desktop" />
    <InternalsVisibleTo Include="Retrocore.Tests" />
    <InternalsVisibleTo Include="Retrocore.Perf" />
    <!-- SDL3's native library, for game controllers, on each platform the extension runs on. -->
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.20" />
    <!-- The schema of retrocore.json, for editors to validate project files with. -->
    <None Update="Project\project-1.schema.json" Link="Schemas\project-1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- SDK ROM sources ship beside the debug host, which assembles them to step through their source. -->
    <None Include="..\..\docs\Bibliography.md" Link="Sdk\Bibliography.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\*.rom.asm" Link="Sdk\Roms\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\ProDosBlockDevice.asm" Link="Sdk\Roms\ProDosBlockDevice.asm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\AppleSoft\*" Link="Sdk\Roms\AppleSoft\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Basic\Roms\Microsoft6502Basic\*" Link="Sdk\Roms\Microsoft6502Basic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\System\*.asm" Link="Sdk\Roms\System\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\System\Monitor\*.asm" Link="Sdk\Roms\System\Monitor\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\System\Firmware.Original\*.asm" Link="Sdk\Roms\System\Firmware.Original\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\System\Firmware.Enhanced\*.asm" Link="Sdk\Roms\System\Firmware.Enhanced\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\DiskII\*" Link="Sdk\Roms\DiskII\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\Dos\*.asm" Link="Sdk\Roms\Dos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\IntegerBasic\*.asm" Link="Sdk\Roms\IntegerBasic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple2\Roms\ProgrammersAid\*" Link="Sdk\Roms\ProgrammersAid\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Trs80\Roms\*.asm" Link="Sdk\Roms\Trs80\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Kaypro\Roms\*.asm" Link="Sdk\Roms\Kaypro\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Altair\Roms\*.asm" Link="Sdk\Roms\Altair\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Kaypro\Roms\Mbasic\*.asm" Link="Sdk\Roms\Kaypro\Mbasic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple3\Roms\*.asm" Link="Sdk\Roms\Apple3\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Pascal\Pcode.asm" Link="Sdk\Pascal\Pcode.asm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Pascal\Sdk\Interpreter\1.1\*" Link="Sdk\Pascal\Interpreter\1.1\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple3\Roms\Sos\*.asm" Link="Sdk\Roms\Apple3\Sos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple3\Roms\BusinessBasic\*.asm" Link="Sdk\Roms\Apple3\BusinessBasic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple3\Roms\Sos\Kernel\*.asm" Link="Sdk\Roms\Apple3\Sos\Kernel\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple3\Roms\Sos\Drivers\**\*.asm" Link="Sdk\Roms\Apple3\Sos\Drivers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple1\Roms\*.asm" Link="Sdk\Roms\Apple1\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Apple1\Roms\Basic\*.asm" Link="Sdk\Roms\Apple1\Basic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Coco\Roms\*.asm" Link="Sdk\Roms\Coco\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Acorn\Roms\*.asm" Link="Sdk\Roms\Acorn\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Acorn\Roms\Mos\*.asm" Link="Sdk\Roms\Acorn\Mos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Acorn\Roms\Basic\*.asm" Link="Sdk\Roms\Acorn\Basic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Acorn\Roms\Dnfs\*.asm" Link="Sdk\Roms\Acorn\Dnfs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Commodore\Roms\**\*.asm;..\Retrocore.Machines.Commodore\Roms\**\*.mac" Link="Sdk\Roms\Pet\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Atari\Roms\*.asm" Exclude="..\Retrocore.Machines.Atari\Roms\*.rom.asm" Link="Sdk\Roms\Atari\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Atari\Roms\Os\*.asm" Link="Sdk\Roms\Atari\Os\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Atari\Roms\FloatingPoint\*.asm" Link="Sdk\Roms\Atari\FloatingPoint\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Retrocore.Machines.Atari\Roms\AtariBasic\*.asm" Link="Sdk\Roms\Atari\AtariBasic\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The SDK's headers for projects, by major version: sdk/1/ is Sdk/1/, which a target's includes search, and its memory
         maps, which a target's build checks its program against. -->
    <None Include="..\..\sdk\**\*.inc" Link="Sdk\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sdk\**\*.map.json" Link="Sdk\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SDL's packages carry each library once per name its platform links by: libSDL3.so, .so.0 and .so.0.4.20 on
       Linux, libSDL3.dylib and libSDL3.0.dylib on macOS, all the same file once packed. .NET loads SDL3-CS's "SDL3"
       as libSDL3.so or libSDL3.dylib, so the other names go, as does 32-bit Windows, which VS Code doesn't run on.
       They go before the deps.json is written, which must list only files that ship. -->
  <Target Name="TrimSdlNativeLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' != '' and $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SDL3-CS.')) and ('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-x86' or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubPath)').Contains('libSDL3.so.')) or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubPath)').EndsWith('libSDL3.0.dylib')))" />
    </ItemGroup>
  </Target>
</Project>
