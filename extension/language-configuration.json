{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(?:::)?[A-Za-z_][\\w\\u0080-\\uFFFF]*(?:::[A-Za-z_][\\w\\u0080-\\uFFFF]*)*|@[\\w\\u0080-\\uFFFF]+|:(?:\\++|-+)|\\$[0-9A-Fa-f]+|%[01]+|0x[0-9A-Fa-f]+|[0-9]+"
}
