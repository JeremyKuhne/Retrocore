; retrocore: dialect=macro10 overlay=../../../Retrocore.Basic/Roms/Microsoft6502Basic/m6502.asm sha256=F3EC99C91DEDB8EB3441DED866F45797BB3E03ED26567A253E24CECF23CD63AC
; Commodore BASIC 1 for the PET 2001: Commodore's changes to Microsoft's 6502 BASIC (m6502.asm), maintained by hand.
; It assembles byte-identically to the BASIC 1 ROMs at $C000-$DFFF: 901447-09 (REVISD=1, the default) or 901447-01
; (REVISD=0) at $C000, then 901447-02, -03 and -04. The base's REALIO=3 build is Commodore's later BASIC; BASIC 1 is
; an earlier Microsoft version, so most edits put back the code as it was before the fixes in the base's change log.
; BASIC continues into the screen editor's ROM: $E000-$E1E0 hold the end of the math package, INIT, the sign-on
; message and Commodore's patches, and one more patch is at $E7F3-$E7F8. The page-zero storage's initial values
; assemble at $00-$DE.
; The revised $C000 ROM fixes STKINI, which in the original stored its return address at the bottom of the stack
; before moving the stack pointer below it, so an interrupt in between could overwrite it.

;@REPLACE 10-10
REALIO=3                        ;COMMODORE.
IFNDEF  REVISD,<REVISD==1>      ;1 FOR THE REVISED $C000 ROM (901447-09), 0 FOR THE ORIGINAL (901447-01).
;@END
; COMMODORE: LONG ERROR MESSAGES.
;@REPLACE 18-18
LNGERR==1                       ;LONG ERROR MESSAGES.
;@END
; COMMODORE: NULL'S CODE STAYS, THOUGH IT HAS NO RESERVED WORD.
;@REPLACE 44-44
        NULCMD==1
;@END
; COMMODORE: BUF IS 80 BYTES IN PAGE ZERO.
;@REPLACE 47-47
        BUFLEN==80
;@END
; COMMODORE: THE CLOCK IS AT $200-$202, OUTSIDE PAGE ZERO.
;@REPLACE 62-62
        CQTIMR=^O1000
;@END
; COMMODORE: BUF IS IN PAGE ZERO AND THE STACK IS THE WHOLE OF PAGE ONE.
;@REPLACE 63-65
;@END
; COMMODORE: THE STATUS BYTE ST IS AT $20C, OUTSIDE PAGE ZERO.
;@REPLACE 66-67
        CQSTAT=^O1014
        CQHTIM=^O110104         ;RND(0) READS $9044, NOT THE TIMER AT $E844.
        CQPNTR=^O342            ;THE SCREEN EDITOR'S CURSOR COLUMN.
;@END
; COMMODORE: BASIC KEEPS ITS OWN TRMPOS IN PAGE ZERO.
;@REPLACE 74-75
        RORSW==1>
;@END
; COMMODORE: 19 STACK LEVELS, AS BEFORE MICROSOFT'S 2/25/78 INCREASE TO 23.
;@REPLACE 238-238
NUMLEV==19                      ;NUMBER OF STACK LEVELS RESERVED
;@END
; COMMODORE: THE TERMINAL STORAGE, LINNUM AND BUF COME RIGHT AFTER USRPOK, SO
; BUF IS AT $0A-$59, THE GENERAL STORAGE FOLLOWS IT AND CHRGET IS AT $C2.
;@INSERT BEFORE 752
; --- RAM DEALING WITH TERMINAL HANDLING ---:
IFN     EXTIO,<
CHANNL: BLOCK   1>              ;HOLDS CHANNEL NUMBER.
IFN     NULCMD,<
NULCNT: 0>                      ;NUMBER OF NULLS TO PRINT.
TRMPOS: BLOCK   1               ;POSITION OF TERMINAL CARRIAGE.
LINWID: LINLEN                  ;LENGTH OF LINE (WIDTH).
NCMWID: NCMPOS                  ;POSITION BEYOND WHICH THERE ARE
                                ;NO MORE FIELDS.
LINNUM: 0                       ;LOCATION TO STORE LINE NUMBER BEFORE BUF
                                ;SO THAT "BLTUC" CAN STORE IT ALL AWAY AT ONCE.
        44                      ;A COMMA (PRELOAD OR FROM ROM)
IFE     BUFPAG,<
BUF:    BLOCK   BUFLEN>         ;TYPE IN STORED HERE.
;@END
; COMMODORE: MOVED ABOVE.
;@DELETE 790-815
; COMMODORE: THE VARIABLE LIST POINTER SHARES LINNUM (MICROSOFT MOVED IT
; 12/1/77 BECAUSE IT CAN SMASH THE COMMA BEFORE BUF).
;@REPLACE 881-881
VARTXT= LINNUM                  ;POINTER INTO LIST OF VARIABLES.
;@END
; COMMODORE: NO "NULL" STATEMENT.
;@DELETE 1016-1017
;@DELETE 1137-1138
; COMMODORE: NO "GO" RESERVED WORD (MICROSOFT ADDED "GO TO" 2/11/78).
;@DELETE 1243-1244
; COMMODORE: FIVE UNUSED BYTES FOLLOW "ILLEGAL QUANTITY", SO THE LATER ERRORS'
; OFFSETS ARE 5 HIGHER.
;@INSERT AFTER 1307
        REPEAT  5,<0>
        Q=Q+5
;@END
; COMMODORE: "BAD DATA" FOR THE FILE DATA ERROR.
;@REPLACE 1336-1338
        DC"BAD DATA"
        ERRBD==Q
        Q=Q+8>
;@END
; COMMODORE: MAIN DOES NOT TAX BEFORE TESTING FOR A BLANK LINE.
;@DELETE 1559-1560
; COMMODORE: NODEL DOES NOT CLEAR OR RELINK BEFORE INSERTING; IT ONLY RESETS
; FRETOP (THE 7/1/78 FIXES CAME LATER).
;@REPLACE 1611-1616
NODEL:  LDA     BUF             ;SEE IF ANYTHNG THERE
        BEQ     FINI
        LDWD    MEMSIZ          ;RESET STRING SPACE.
        STWD    FRETOP
;@END
; COMMODORE: FINI FALLS INTO LNKPRG, WHICH RETURNS TO MAIN ITSELF.
;@REPLACE 1638-1641
FINI:   JSR     RUNC            ;DO CLEAR & SET UP STACK.
                                ;AND SET [TXTPTR] TO [TXTTAB]-1.
;@END
; COMMODORE: AT THE END OF THE PROGRAM, LNKPRG GOES BACK TO MAIN.
;@REPLACE 1653-1653
        JEQ     MAIN            ;END OF THE PROGRAM: GET THE NEXT LINE.
;@END
; COMMODORE: SO LNKPRG HAS NO RTS.
;@DELETE 1671-1671
; COMMODORE: KEEPS THE LINE-EDITING EXITS LINLIN AND INLINN, THOUGH NOTHING
; BRANCHES TO LINLIN.
;@DELETE 1701-1701
; COMMODORE: INLINN ALWAYS TYPES A CRLF.
;@REPLACE 1709-1709
        JSR     CRDO
;@END
; COMMODORE: SPACES ARE STILL SKIPPED INSIDE RESERVED WORDS (MICROSOFT
; DISALLOWED THEM 2/11/78).
;@INSERT AFTER 1819
        CMPI    " "             ;SKIP SPACES.
        BEQ     RESPUL
;@END
; COMMODORE: NO CLC BEFORE ADDING 2; THE CARRY IS ALREADY CLEAR.
;@DELETE 1916-1916
; COMMODORE: CLEAR IS NOT HERE BUT AFTER NULL, SO RUNC FALLS STRAIGHT INTO CLEARC.
;@DELETE 1923-1927
; COMMODORE: THE REVISED ROM PUSHES THE RETURN ADDRESS AFTER MOVING THE STACK
; POINTER. THE ORIGINAL STORED IT AT THE BOTTOM OF THE STACK FIRST AND MOVED
; THE POINTER BELOW IT AFTERWARD, SO AN INTERRUPT IN BETWEEN COULD OVERWRITE IT.
;@REPLACE 1951-1958
IFN     REVISD,<
        PLA                     ;SETUP RETURN ADDRESS.
        TAY
        PLA
        LDXI    STKEND-257
        TXS
        PHA
        TYA
        PHA>
IFE     REVISD,<
        PLA                     ;SETUP RETURN ADDRESS.
        STA     STKEND-2
        PLA
        STA     STKEND-1
        LDXI    STKEND-259
        TXS>
;@END
; COMMODORE: THE REVISED STKINI IS TWO BYTES SHORTER. ITS LAST BYTE STAYS
; PUT, SO THE ORIGINAL'S FINAL RTS IS STILL WHERE LIST BRANCHES TO STKRTS.
;@REPLACE 1962-1962
IFN     REVISD,<
        RTS
        81>                     ;A SPARE BYTE.
STKRTS: RTS
;@END
; COMMODORE: NO CHECK FOR 256 CHARACTERS IN A LINE.
;@DELETE 2025-2028
; COMMODORE: NEWSTT CHECKS FOR ":" BEFORE LOOKING AT THE LINK.
;@REPLACE 2149-2149
        BEQ     NXTLIN          ;END OF THE LINE
        CMPI    ":"
        BEQ     GONE            ;IF A ":" CONTINUE STATEMENT
SNERR1: JMP     SNERR           ;NEITHER 0 OR ":" SO SYNTAX ERROR
NXTLIN:
;@END
; COMMODORE: A SHORT BRANCH TO ENDCON.
;@REPLACE 2153-2153
        BEQ     ENDCON          ;YES - RAN OFF THE END.
;@END
; COMMODORE: GONE3 RETURNS THROUGH CONTRT AND SETS THE CARRY FOR GONE2.
;@REPLACE 2168-2175
GONE3:  BEQ     CONTRT          ;IF TERMINATOR, TRY AGAIN.
        SEC
GONE2:  SBCI    ENDTK           ;" ON ... GOTO AND GOSUB" COME HERE.
        BCS     GONE4
        JMP     LET             ;MUST BE A LET
GONE4:  CMPI    SCRATK-ENDTK+1
        BCS     SNERR1          ;SOME RES'D WORD BUT NOT
                                ;A STATEMENT RES'D WORD.
;@END
; COMMODORE: GLET, MORSTS AND SNERR1 ARE ABOVE, AND THERE IS NO "GO".
;@DELETE 2184-2192
; COMMODORE: NULL ALLOWS UP TO 9 NULLS.
;@REPLACE 2272-2272
        CPXI    10              ;IS THE NUMBER REASONABLE?
;@END
; COMMODORE: THE CLEAR STATEMENT.
;@INSERT AFTER 2277
CLEAR:  BNE     CONTRT          ;SYNTAX ERROR IF NO TERMINATOR.
        JMP     CLEARC
;@END
; COMMODORE: RETURN MAKES SURE THE LOW BYTE OF THE VARIABLE POINTER NEVER
; MATCHES (MICROSOFT FIXED THIS 7/27/78 TO USE THE HIGH BYTE).
;@REPLACE 2419-2419
        STA     FORPNT          ;MAKE SURE THE VARIABLE'S PNTR
;@END
; COMMODORE: REMER TESTS FOR THE QUOTE THE OTHER WAY AROUND.
;@REPLACE 2461-2462
        BEQ     EXCHQT          ;YES, TIME TO TRADE.
        BNEA    REMER           ;NO, JUST CONTINUE.
;@END
; COMMODORE: A LONG JUMP TO FCERR FOR A TI$ STRING OF THE WRONG LENGTH.
;@REPLACE 2579-2579
        JNE     FCERR
;@END
; COMMODORE: THE CARRY DOES NOT TELL SPC( FROM TAB(.
;@DELETE 2676-2676
; COMMODORE: CRDO AND CRFIN TRACK BASIC'S OWN TRMPOS.
;@DELETE 2716-2716
;@REPLACE 2719-2719
        STA     TRMPOS
;@END
;@REPLACE 2726-2728
        LDA     CHANNL
        BNE     PRTRTS>
;@END
; COMMODORE: TABER SAVES THE TOKEN ITSELF AND COMPARES IT. SPC( PRINTS [X]
; SPACES WITH A DECREMENT AT THE END OF THE LOOP, AND TAB( TO THE CURRENT
; POSITION PRINTS NONE.
;@REPLACE 2764-2780
TABER:  PHA                     ;REMEMBER IF SPC OR TAB FUNCTION.
        JSR     GTBYTC          ;GET VALUE INTO ACCX.
        CMPI    41
        BNE     SNERR4
        PLA
        CMPI    TABTK
        BNE     XSPAC           ;PRINT [X] SPACES.
        TXA
        SBC     TRMPOS
        BCC     NOTABR          ;NEGATIVE, DON'T PRINT ANY.
        BEQ     NOTABR
ASPAC:  TAX
XSPAC:  JSR     OUTSPC
        DEX                     ;DECREMENT THE COUNT.
        BNE     XSPAC
NOTABR: JSR     CHRGET          ;REGET LAST CHARACTER.
        JMP     PRINTC          ;DON'T CALL CRDO.
;@END
; COMMODORE: OUTSPC ALWAYS PRINTS THE SKIP CHARACTER.
;@REPLACE 2808-2815
        LDAI    29              ;COMMODORE'S SKIP CHARACTER.
;@END
; COMMODORE: OUTDO KEEPS TRMPOS ITSELF: CURSOR RIGHT AND PRINTING CHARACTERS
; ADVANCE IT, CURSOR LEFT AND DELETE BACK IT UP. ONLY OUTPUT TO THE SCREEN
; COUNTS. A PATCH IN INCTRM WRAPS IT AT THE END OF THE SCREEN LINE.
;@REPLACE 2821-2834
        PHA
        CMPI    29              ;SKIP?
        BEQ     OUTDO1
        CMPI    157             ;CURSOR LEFT?
        BEQ     DECTRM
        CMPI    20              ;DELETE?
        BNE     OUTDO2
DECTRM: LDA     TRMPOS
        BEQ     TRYOUT
        LDA     CHANNL
        BNE     TRYOUT
        DEC     TRMPOS
OUTDO2: ANDI    127
        CMPI    32              ;IS THIS A PRINTING CHAR?
        BCC     TRYOUT          ;NO, DON'T INCLUDE IT IN TRMPOS.
OUTDO1: LDA     CHANNL
        JSR     INCTRM          ;INCREMENT COUNT IF ON THE SCREEN.
        NOP
TRYOUT: PLA                     ;RESTORE THE A REGISTER
;@END
; COMMODORE: A PATCH, GETDTL, PICKS THE LINE NUMBER: THE DATA LINE FOR READ,
; DIRECT FOR GET.
;@REPLACE 2860-2865
        JSR     GETDTL          ;GET DATA LINE NUMBER.
        NOP
;@END
; COMMODORE: AN EMPTY INPUT LINE STOPS THROUGH A PATCH, INPSTP, THAT CLEARS
; THE CARRY SO "BREAK" IS NOT PRINTED.
;@REPLACE 2939-2940
        JMP     INPSTP          ;NO, STOP.
;@END
; COMMODORE: GET POINTS AT BUF-1 WITHOUT THE LDXYI MACRO.
;@REPLACE 2985-2989
        LDYI    0
        LDXI    <BUF-1>         ;POINT JUST BEFORE IT.
        BNEA    DATBK>          ;GO PROCESS.
;@END
; COMMODORE: GETSTR, A PATCH, ZEROES THE TERMINATORS AND MOVES THE TEXT
; POINTER PAST THE CHARACTER FOR GET.
;@REPLACE 3003-3007
        LDAI    0               ;ZERO TERMINATORS.
        JSR     GETSTR
        NOP>
;@END
; COMMODORE: NEXT COUNTS THE STACK POINTER UP TO THE INCREMENT AND THE LIMIT.
;@REPLACE 3120-3126
        REPEAT  4,<INX>         ;POINT TO INCREMENT
        TXA                     ;KEEP THIS POINTER IN [A]
        REPEAT  5+ADDPRC,<INX>  ;POINT TO UPPER LIMIT
        STX     INDEX2          ;SAVE AS INDEX
;@END
; COMMODORE: ISVAR DOES NOT CLEAR FACOV, AND PATCHES, TISTR AND TINUM, MAKE SURE
; TI$ AND TI ARE NOT ARRAY ELEMENTS. EACH PATCH JUMP REPLACED A CMPI "T" AND
; ITS BRANCH, WHOSE OFFSET IS LEFT OVER.
;@REPLACE 3405-3411
IFN     TIME,<
        JMP     TISTR           ;TI$?
        24
TISTR1:
;@END
;@REPLACE 3437-3441
IFN     TIME,<
        JMP     TINUM           ;TI?
        25
TINUM1:
;@END
; COMMODORE: TI'S CHECK FOR "I" GOES ON TO QSTATV.
;@REPLACE 3443-3443
        BNE     QSTATV
;@END
; COMMODORE: THE SIMULATED ZERO IS TWO BYTES OF ITS OWN AFTER LDZR, NOT PART
; OF FHALF.
;@INSERT AFTER 3720
ZERO:   0
        0
;@END
; COMMODORE: INTIDX USES FRMNUM, AND POSINT DOES NOT CHECK FOR A NUMBER ITSELF.
;@REPLACE 3800-3801
        JSR     FRMNUM          ;GET A NUMBER
POSINT:
;@END
; COMMODORE: NO FIX FOR THE ARRAY BUG.
;@DELETE 4051-4051
; COMMODORE: NO ERRGUF; FNDOER LOADS ERRUF BEFORE ITS CHECK (MICROSOFT MOVED IT
; 1/24/78 BECAUSE THE TAX THAT FOLLOWS SMASHES IT).
;@DELETE 4158-4159
;@REPLACE 4191-4198
        LDYI    2
        LDXI    ERRUF           ;USER DEFINED FUNCTION NEVER DEFINED
        LDADY   DEFPNT          ;GET POINTER TO VARIABLE.
        BEQ     ERRGO1
        STA     VARPNT          ;SAVE VARIABLE POINTER.
        TAX
        INY
        LDADY   DEFPNT
        STA     VARPNT+1
;@END
; COMMODORE: STRLIT DOES NOT CLEAR FACOV.
;@DELETE 4325-4325
; COMMODORE: THE GARBAGE COLLECTOR CLEARS ONLY THE HIGH BYTE OF GRBPNT AND
; TESTS ONLY IT (MICROSOFT'S 7/1/78 FIX FOR COMMODORE BUG #2 TESTS BOTH).
;@DELETE 4380-4380
; COMMODORE: A PATCH, ARYINC, RESETS [Y] AFTER COMPUTING THE STEP TO THE NEXT
; ARRAY.
;@REPLACE 4430-4432
        JSR     ARYINC          ;CARRY IS OFF AND OFF AFTER ADD.
;@END
; COMMODORE: GRBPAS TESTS THE HIGH BYTE ONLY, AND COMPUTES THE DESCRIPTOR
; OFFSET BY SUBTRACTING.
;@REPLACE 4488-4489
GRBPAS: LDX     GRBPNT+1        ;VARIABLE POINTER.
;@END
;@REPLACE 4492-4492
        SBCI    3               ;LEAVES C OFF.
;@END
; COMMODORE: PREAM REJECTS A LENGTH OR POSITION OF 0 FOR LEFT$, RIGHT$ AND MID$
; ALIKE AND RETURNS THROUGH JMPER (MICROSOFT ALLOWED 0 FOR LEFT$ AND RIGHT$
; 3/9/78).
;@DELETE 4692-4692
;@REPLACE 4710-4725
        PLA                     ;GET THE RETURN ADDRESS INTO
        STA     JMPER+1         ;[JMPER+1].
        PLA
        STA     JMPER+2
        PLA                     ;GET RID OF FINGO'S JSR RET ADDR.
        PLA
        PLA                     ;GET LENGTH.
        TAX
        PULWD   DSCPNT
        LDYI    0
        TXA
        BEQ     GOFUC           ;A LENGTH OF 0 IS AN ERROR.
        INC     JMPER+1         ;RETURN.
        JMPD    JMPER+1
;@END
; COMMODORE: ASC SHARES LEN'S JUMP TO SNGFLT.
;@REPLACE 4731-4731
LENFLT: JMP     SNGFLT
;@END
;@REPLACE 4746-4746
        JMP     LENFLT
;@END
; COMMODORE: PEEK DOES NOT SAVE POKER (MICROSOFT FIXED PEEK SMASHING IT 12/1/77).
;@REPLACE 4808-4809
PEEK:   JSR     GETADR
;@END
;@REPLACE 4818-4819
DOSGFL: JMP     SNGFLT          ;FLOAT IT.
;@END
; COMMODORE: NO HIDDEN MESSAGE BEHIND WAIT.
;@REPLACE 4836-4836
        BEQ     STORDO
;@END
; COMMODORE: NO ZSTORD.
;@DELETE 4910-4941
; COMMODORE: A SHORT BRANCH TO MULTRT.
;@REPLACE 5265-5265
FMULTT: BEQ     MULTRT          ;IF FAC=0, RETURN. FAC IS SET.
;@END
; COMMODORE: AN ACCUMULATED EXPONENT OF 12 OR MORE OVERFLOWS IF POSITIVE.
; IF NEGATIVE, 11 IS USED FOR THE SHIFTED TERM BUT THE OLD TENEXP IS STILL
; ADDED: THE NEXT BYTE IS (88 + 2 * OLD EXPONENT + DIGIT) MODULO 256.
;@REPLACE 5790-5796
        CMPI    14              ;WILL RESULT BE .GE. 120?
        BCC     MLEX10
        BIT     EXPSGN
        BMI     MLEXMI          ;IF NEG EXP, NO CHK FOR OVERR.
        JMP     OVERR
MLEXMI: LDAI    13              ;USE 11.
MLEX10: ASL     A,              ;MULT BY 2 TWICE
;@END
;@REPLACE 5806-5806
        STA     TENEXP          ;SAVE RESULT.
;@END
; COMMODORE: NZ9999 IS 999999999.5.
;@REPLACE 5834-5834
        376
;@END
; COMMODORE: ZERO IS AFTER LDZR.
;@REPLACE 6011-6011
        000
;@END
; COMMODORE: NO CONSTANTS FOR THE HIDDEN MESSAGE AFTER SINCON.
;@REPLACE 6529-6539
        242>
;@END
; COMMODORE: THE LAST BYTE OF THE RANDOM SEED IS 89, AS IN PAGE ZERO, THOUGH
; MOVCHG DOES NOT COPY IT.
;@REPLACE 6698-6698
IFN     ADDPRC,<89>
;@END
; COMMODORE: INIT MAKES THE LINE LOOK DIRECT TOO.
;@DELETE 6704-6704
;@REPLACE 6706-6706
        STX     CURLIN+1        ;ERROR MESSAGE.
;@END
; COMMODORE: LINWID AND NCMWID ARE NOT SET UP, AND FOUR6 IS SET UP LATER.
;@DELETE 6728-6732
;@DELETE 6738-6739
; COMMODORE: INIT ZEROES TRMPOS, PUTS DOWN THE COMMA BEFORE BUF AND TYPES A CR.
;@INSERT AFTER 6746
        STA     TRMPOS
;@END
;@INSERT AFTER 6750
        LDAI    STRSIZ
        STA     FOUR6
        LDAI    44              ;A COMMA BEFORE BUF.
        STA     LINNUM+1
        JSR     CRDO            ;TYPE A CR.
;@END
; COMMODORE: THE MEMORY SIZE SEARCH STARTS FROM [A]=0 AND STOPS AT $8000,
; WHERE THE SCREEN IS, WRITING $92 AND $24.
;@REPLACE 6771-6772
IFE     REALIO-3,<
        LDAI    0
        LDYI    RAMLOC/^D256>
;@END
;@DELETE 6778-6779
;@REPLACE 6781-6784
        LDYI    0
;@END
;@REPLACE 6788-6790
        LDA     LINNUM+1
        CMPI    ^O200           ;THE SCREEN?
        BEQ     USEDEC
LOOPM1: LDAI    ^O222           ;PUT RANDOM INFO INTO MEM.
;@END
; COMMODORE: INIT CARRIES INTO TXTTAB+1.
;@DELETE 6880-6880
;@REPLACE 6882-6882
        INC     TXTTAB+1
;@END
; COMMODORE: THE SIGN-ON MESSAGE FOLLOWS " BYTES FREE".
;@REPLACE 6885-6889
        JSR     CRDO
;@END
; COMMODORE: AFTER " BYTES FREE", HOME THE CURSOR, PRINT THE SIGN-ON MESSAGE
; AT THE TOP OF THE SCREEN AND MOVE DOWN THREE LINES.
;@REPLACE 6930-6939
IFE     REALIO-3,<
        EXP     ^O23            ;HOME.
        DT"*** COMMODORE BASIC ***"
        EXP     ^O21            ;CURSOR DOWN.
        EXP     ^O21
        EXP     ^O21>
;@END
; COMMODORE: PATCHES, AFTER THE SIGN-ON MESSAGE.
;@INSERT BEFORE 6947
INPSTP: CLC                     ;MAKE SURE DONT PRINT BREAK
        JMP     STPEND
TISTR:  BIT     FACLO           ;AN ARRAY?
        BPL     TISTR2          ;YES.
        CMPI    "T"             ;TI$?
        BNE     TISTR2
        JMP     TISTR1
TISTR2: RTS
TINUM:  BIT     FACLO           ;AN ARRAY?
        BMI     TINUM2
        JMP     GOMOVF          ;YES.
TINUM2: CMPI    "T"
        BEQ     TINUM3
        JMP     QSTATV
TINUM3: JMP     TINUM1
GETSTR: STA     CHARAC
        INX
        JMP     GETST1
GETDTL: BPL     GETDT1          ;GET?
        LDWD    DATLIN          ;NO, GET DATA LINE NUMBER.
        RTS
GETDT1: LDYI    255             ;MAKE IT LOOK DIRECT.
        RTS
INCTRM: BNE     INCTR2          ;ONLY COUNT OUTPUT TO THE SCREEN.
INCTR1: INC     TRMPOS
        BNE     INCTR2
        LDA     CQPNTR          ;PAST 255: USE THE CURSOR COLUMN.
        STA     TRMPOS
        BNE     INCTR1
INCTR2: RTS
GETST1: STX     TXTPTR
        PLA
        PLA
        TYA
        JMP     RESETC
;@END
; COMMODORE: NO TEMPORARY STACK. THE LAST PATCH IS AT THE END OF THE SCREEN
; EDITOR'S ROM, AT $E7F3.
;@REPLACE 6948-6948
        ORG     ^O163763
ARYINC: ASL     A,              ;STEP TO THE NEXT ARRAY.
        ADCI    5
        LDYI    0               ;RESET INDEX Y.
        RTS
;@END
