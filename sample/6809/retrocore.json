// A 6809 project: a hello world for the SDK's Color Computer environments, each target with its machine's console in
// src/platform/<family>/ and its environment's Exit in src/platform/<environment>/, as the 6502 template lays them
// out. Build it with `retrocore build --all` here; ProjectLaunchTests boots each target and reads its screen.
{
  "sdk": "1",
  "name": "hello",
  "cpu": "6809",
  "sources": ["src/*.s"],
  "entry": "Main",
  "targets": {
    "coco-colorbasic": { "machine": "coco2", "environment": "colorbasic" },
    "coco3-colorbasic": { "machine": "coco3", "environment": "colorbasic" },
    "coco-diskbasic": { "machine": "coco2", "environment": "diskbasic" },
    "coco3-diskbasic": { "machine": "coco3", "environment": "diskbasic" }
  }
}
