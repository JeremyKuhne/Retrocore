{
  "comments": {
    "blockComment": ["(*", "*)"]
  },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["string"] },
    { "open": "(*", "close": " *)", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["'", "'"]
  ],
  "wordPattern": "[A-Za-z][A-Za-z0-9_]*|[0-9]+(\\.[0-9]+)?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((?i)begin|repeat|record|case\\b.*\\bof)\\b.*$",
    "decreaseIndentPattern": "^\\s*((?i)end|until)\\b.*$"
  }
}
