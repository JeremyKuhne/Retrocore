; retrocore: dialect=macro10 overlay=../../../Retrocore.Basic/Roms/Microsoft6502Basic/m6502.asm sha256=F3EC99C91DEDB8EB3441DED866F45797BB3E03ED26567A253E24CECF23CD63AC
; COMMODORE BASIC 2 FOR THE PET 2001: COMMODORE'S CHANGES TO MICROSOFT BASIC 1.1 (M6502.ASM), MAINTAINED BY HAND.
; IT ASSEMBLES BYTE-IDENTICALLY TO THE UPGRADE ROMS 901465-01 ($C000-$CFFF) AND 901465-02 ($D000-$DFFF).
; THE BASE'S OWN COMMODORE BUILD (REALIO=3) GIVES THE PET'S PAGE-ZERO LAYOUT, ROMLOC ($C000), THE KERNAL'S
; JUMP TABLE AT $FFC0-$FFE4, THE TOKEN TABLE AND THE SIGN-ON MESSAGE AS THE ROM HAS THEM; THE EDITS BELOW ARE
; WHAT COMMODORE CHANGED BEYOND THAT. THE CODE RUNS PAST $DFFF: ITS LAST $1DE BYTES, THE END OF THE MATH
; PACKAGE (ATN), INIT AND THE SIGN-ON TEXT, ARE THE FIRST BYTES OF THE EDITOR ROM AT $E000-$E1DD.
;@REPLACE 10-10
REALIO=3                        ;3=COMMODORE: THE PET 2001.
;@END
;@REPLACE 18-18
LNGERR==1                       ;LONG ERROR MESSAGES. (COMMODORE: "SYNTAX", NOT "SN")
;@END
;@INSERT AFTER 2142
        NOP                     ;COMMODORE: A SPARE BYTE THE ROM HAS BETWEEN THE COMPARE AND ITS BRANCH.
;@END
;@REPLACE 4811-4815
; COMMODORE: PEEK READS THE BASIC ROM TOO. THE BASE'S CHECK, WHICH GIVES ZERO FOR AN ADDRESS FROM ROMLOC UP TO
; LASTWR, IS PATCHED OUT WITH AS MANY NOPS AS IT HAD BYTES.
        REPEAT  8,<NOP>
;@END
