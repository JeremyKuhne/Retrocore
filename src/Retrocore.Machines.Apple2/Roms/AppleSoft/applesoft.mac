        STA     FRETOP          ;$F7B0
        STA     A1L             ;$F7B2
        JSR     RD2BIT          ;$F7B4 $FCFA
        LDAI    ^D3             ;$F7B7
        JMP     MREAD+5         ;$F7B9 $FF02
SETA2:
        CLC             ;$F7BC
        LDA     LOWTR           ;$F7BD
        ADC     LINNUM          ;$F7BF
        STA     A2L             ;$F7C1
        LDA     EXPSGN          ;$F7C3
        ADC     LINNUM+1                ;$F7C5
        STA     A2H             ;$F7C7
        LDYI    ^D4             ;$F7C9
        LDADY   LOWTR           ;$F7CB
        JSR     FMAPT1          ;$F7CD $E0EF
        LDA     HIGHDS          ;$F7D0
        STA     A1L             ;$F7D2
        LDA     HIGHDS+1                ;$F7D4
        STA     A1H             ;$F7D6
        RTS             ;$F7D8
>
GETARYPT:
        LDAI    ^D64            ;$F7D9
        STA     SUBFLG          ;$F7DB
        JSR     PTRGET          ;$F7DD $DFE3
        LDAI    ^D0             ;$F7E0
        STA     SUBFLG          ;$F7E2
        JMP     VARTIO          ;$F7E4 $D8F0
HTAB:
        JSR     GETBYT          ;$F7E7 $E6F8
        DEX             ;$F7EA
IFN     ENHNCD,<                ;ENHANCED IIE
HTAB1:
        LDAI    ^D40            ;$F7EB
        CMP     WNDWDT          ;$F7ED
        BCS     HTAB12          ;$F7EF
        LDA     WNDWDT          ;$F7F1
HTAB12:
        JSR     TRMSE1          ;$F7F3 $F7CA
        STX     TRMPOS          ;$F7F6
        BCC     TRMSE2          ;$F7F8
        TAX             ;$F7FA
        JSR     CRDO            ;$F7FB $DAFB
        BNE     HTAB1           ;$F7FE
>
IFE     ENHNCD,<                ;ORIGINAL IIE
        TXA             ;$F7EB
HTAB11:
        CMPI    ^D40            ;$F7EC
        BCC     HTAB13          ;$F7EE
        SBCI    ^D40            ;$F7F0
        PHA             ;$F7F2
        JSR     CRDO            ;$F7F3 $DAFB
        PLA             ;$F7F6
        JMP     HTAB11          ;$F7F7 $F7EC
HTAB13:
        STA     TRMPOS          ;$F7FA
        RTS             ;$F7FC
IFE     APLPLS,<
        EXP     ^D203,^D210,^D120               ;$F7FD
>
IFN     APLPLS,<                ;II PLUS: THE CHIP'S LAST BYTE DIFFERS.
        EXP     ^D203,^D210,^D215               ;$F7FD
>
>
;@END
