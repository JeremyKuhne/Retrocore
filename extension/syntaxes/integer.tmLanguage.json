        },
        {
          "match": "(?:\\d+\\.?\\d*|\\.\\d+)(?:[EeDd][+-]?\\d+)?",
          "name": "constant.numeric.retrocore-integer"
        },
        {
          "match": "[A-Za-z][A-Za-z0-9]*\\$?",
          "name": "variable.other.retrocore-integer"
        },
        {
          "match": ":",
          "name": "punctuation.separator.statement.retrocore-integer"
        },
        {
          "match": "[;,]",
          "name": "punctuation.separator.retrocore-integer"
        }
      ]
    },
    "remark": {
      "match": "(?i:(REM)).*$",
      "name": "comment.line.retrocore-integer",
      "captures": {
        "1": {
          "name": "keyword.other.remark.retrocore-integer"
        },
        "2": {
          "name": "keyword.other.remark.retrocore-integer"
        }
      }
    },
    "data": {
      "begin": "(?i:(DATA))",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.retrocore-integer"
        }
      },
      "end": "(?=:|$)",
      "contentName": "string.unquoted.data.retrocore-integer",
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#escape"
        }
      ]
    },
    "string": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.retrocore-integer",
      "patterns": [
        {
          "include": "#escape"
        }
      ]
    },
    "escape": {
      "match": "\\{(?:\\{|\\$[0-9A-Fa-f]{2}|CTRL-.)\\}",
      "name": "constant.character.escape.retrocore-integer"
    }
  }
