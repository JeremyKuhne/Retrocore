    <ProjectReference Include="..\Retrocore.Input\Retrocore.Input.csproj" />
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <ProjectReference Include="..\Retrocore.Media\Retrocore.Media.csproj" />
    <ProjectReference Include="..\Retrocore.Machines.Apple2\Retrocore.Machines.Apple2.csproj" />
    <InternalsVisibleTo Include="AppleSharp.tests" />
    <None Update="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
