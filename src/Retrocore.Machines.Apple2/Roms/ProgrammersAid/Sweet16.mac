; retrocore: style=strict
;; SWEET16 instructions as macros
;;
;; Steve Wozniak's SWEET16 is a 16-bit interpreter in the Integer BASIC ROM (<SW16>): a 6502 program calls it,
;; and the bytes after it are SWEET16 instructions, up to an <RTN>, after which the 6502 carries on.
;; Renumber and Relocate are partly written in it. These macros assemble its instructions with Apple's mnemonics.
;;
;; A register is a number from 0 to 15, usually a name for one. The instructions that go through a register, which Apple
;; writes @R, take it in brackets here, as memory operands are written on the Z80: `LD [PASS1_LINE]` loads the byte that
;; register points to, while `LD PASS1_LINE` copies the register. A branch takes its target and assembles the signed
;; offset from the byte after it. The macros keep Apple's mnemonics as their names, as an instruction set's mnemonics
;; are kept (the conversion log, docs/conversions/ProgrammersAid.md). Part of ProgrammersAid.asm.

;; SWEET16's sixteen registers, two bytes each, low byte first: R0 at $00 up to R15 at $1E.
;;
;; R0 is the accumulator, R12 the stack pointer of SWEET16's subroutine calls, R13 the result of a compare, R14 the
;; status and R15 the program counter. Programmer's Aid's 6502 routines also use these bytes for their own, and name
;; them from this.
Sweet16Registers = $00

;; The size of a SWEET16 register, in bytes.
SWEET16_REGISTER_SIZE = 2

;; SET Rn: loads a 16-bit constant into a register.
;; Parameters: register = the register, value = the constant
.macro SET register, value
    .byte $10 | (register), <(value), >(value)
.endmacro

;; LD Rn copies a register to R0, the accumulator; LD [Rn] loads the byte the register points to, which then steps
;; up.
;; Parameters: register = the register, or the register in brackets
.macro LD register
    .if .match(.left(1, {register}), [)
        .byte $40 | (.mid(1, 1, {register}))
    .else
        .byte $20 | (register)
    .endif
.endmacro

;; ST Rn copies R0 to a register; ST [Rn] stores R0's low byte where the register points, which then steps up.
;; Parameters: register = the register, or the register in brackets
.macro ST register
    .if .match(.left(1, {register}), [)
        .byte $50 | (.mid(1, 1, {register}))
    .else
        .byte $30 | (register)
    .endif
.endmacro

;; LDD [Rn]: loads the two bytes the register points to into R0; the register steps up by 2.
;; Parameters: register = the register in brackets
.macro LDD register
    .if .match(.left(1, {register}), [)
        .byte $60 | (.mid(1, 1, {register}))
    .else
        .error "LDD goes through a register: write it in brackets, as [R]."
    .endif
.endmacro

;; STD [Rn]: stores R0's two bytes where the register points; the register steps up by 2.
;; Parameters: register = the register in brackets
.macro STD register
    .if .match(.left(1, {register}), [)
        .byte $70 | (.mid(1, 1, {register}))
    .else
        .error "STD goes through a register: write it in brackets, as [R]."
    .endif
.endmacro

;; POP [Rn]: steps the register down, then loads the byte it points to into R0.
;; Parameters: register = the register in brackets
.macro POP register
    .if .match(.left(1, {register}), [)
        .byte $80 | (.mid(1, 1, {register}))
    .else
        .error "POP goes through a register: write it in brackets, as [R]."
    .endif
.endmacro

;; STP [Rn]: steps the register down, then stores R0's low byte where it points.
;; Parameters: register = the register in brackets
.macro STP register
    .if .match(.left(1, {register}), [)
        .byte $90 | (.mid(1, 1, {register}))
    .else
        .error "STP goes through a register: write it in brackets, as [R]."
    .endif
.endmacro

;; POPD [Rn]: steps the register down by 2, then loads the two bytes it points to into R0.
;; Parameters: register = the register in brackets
.macro POPD register
    .if .match(.left(1, {register}), [)
        .byte $C0 | (.mid(1, 1, {register}))
    .else
        .error "POPD goes through a register: write it in brackets, as [R]."
    .endif
.endmacro

;; ADD Rn: R0 = R0 + the register.
;; Parameters: register = the register
.macro ADD register
    .byte $A0 | (register)
.endmacro

;; SUB Rn: R0 = R0 - the register.
;; Parameters: register = the register
.macro SUB register
    .byte $B0 | (register)
.endmacro

;; CPR Rn: R13 = R0 - the register, for the branches that follow.
;; Parameters: register = the register
.macro CPR register
    .byte $D0 | (register)
.endmacro

;; INR Rn: adds 1 to the register.
;; Parameters: register = the register
.macro INR register
    .byte $E0 | (register)
.endmacro

;; DCR Rn: subtracts 1 from the register.
;; Parameters: register = the register
.macro DCR register
    .byte $F0 | (register)
.endmacro

;; RTN: returns to the 6502 code after the instruction.
.macro RTN
    .byte $00
.endmacro

;; NUL: does nothing, passing over the byte after it, as an untaken branch does; Apple's listings write it as the
;; byte $0D to skip a 1-byte instruction.
.macro NUL
    .byte $0D
.endmacro

;; SET Rn without its constant: the 2 bytes after it become the register's value, so SWEET16 passes over them. Apple's
;; listings write it as the byte to skip the next two bytes of instructions, at the cost of the register.
;; Parameters: register = the register it overwrites
.macro SetSkippingTwo register
    .byte $10 | (register)
.endmacro

;; Assembles a branch: the opcode and the signed offset to the target from the byte after the offset.
;; Parameters: opcode = the branch's opcode, target = where it goes
.macro Sweet16Branch opcode, target
    .assert (target) - (* + 2) >= -128 && (target) - (* + 2) <= 127, "The SWEET16 branch is out of range."
    .byte (opcode)
    .byte <((target) - (* + 1))       ; the offset counts from the byte after it
.endmacro

;; BR: branches always.
;; Parameters: target = where it goes
.macro BR target
    Sweet16Branch $01, target
.endmacro

;; BNC: branches if the last result left no carry.
;; Parameters: target = where it goes
.macro BNC target
    Sweet16Branch $02, target
.endmacro

;; BC: branches if the last result carried.
;; Parameters: target = where it goes
.macro BC target
    Sweet16Branch $03, target
.endmacro

;; BP: branches if the last result was positive.
;; Parameters: target = where it goes
.macro BP target
    Sweet16Branch $04, target
.endmacro

;; BM: branches if the last result was negative.
;; Parameters: target = where it goes
.macro BM target
    Sweet16Branch $05, target
.endmacro

;; BZ: branches if the last result was zero.
;; Parameters: target = where it goes
.macro BZ target
    Sweet16Branch $06, target
.endmacro

;; BNZ: branches if the last result was not zero.
;; Parameters: target = where it goes
.macro BNZ target
    Sweet16Branch $07, target
.endmacro

;; BM1: branches if the last result was -1.
;; Parameters: target = where it goes
.macro BM1 target
    Sweet16Branch $08, target
.endmacro

;; BNM1: branches if the last result was not -1.
;; Parameters: target = where it goes
.macro BNM1 target
    Sweet16Branch $09, target
.endmacro

;; BS: calls a SWEET16 subroutine, keeping the return address on the stack R12 points to.
;; Parameters: target = the subroutine
.macro BS target
    Sweet16Branch $0C, target
.endmacro
